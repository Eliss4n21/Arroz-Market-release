# ── Copie para .env e preencha. NUNCA versione o .env. ──

# Porta (Railway injeta PORT automaticamente — não altere)
PORT=3000

# JWT — gere: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=TROQUE_POR_STRING_64_CHARS_ALEATORIA
JWT_EXPIRES=7d

# Ambiente
NODE_ENV=production

# CORS — Railway: deixe * durante dev | VPS: coloque seu domínio
CORS_ORIGIN=*

# Scraping em minutos (padrão 60)
SCRAPE_INTERVAL_MIN=60

# ── Apenas para VPS / Hostgator ──
# DATA_DIR=/home/SEU_USUARIO/arrozmarket_data
# AUDIO_DIR=/home/SEU_USUARIO/arrozmarket_data/audios
